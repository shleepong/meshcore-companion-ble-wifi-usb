From e90124b91bbbd32a0990f4f813084a46c3cea899 Mon Sep 17 00:00:00 2001
From: GNB Build <palimpseste@quidam.eu>
Date: Sun, 30 Aug 2026 18:07:05 +0200
Subject: [PATCH 15/17] feat(ui): battery percentage instead of icon, new
 BATTERY page

Top-right battery icon (24x10px, a handful of fill increments) replaced with
the exact percentage as text (already computed internally for the icon's
fill width, just never surfaced as a number). Same linear mV approximation
as before, now visible precisely instead of implied.

New BATTERY home page, right before SHUTDOWN (last page): percentage,
voltage, and the reference range used for the estimate, so it's clear this
is an approximation, not a lab-accurate reading. Mirrors the existing RADIO
page's plain text-lines style, no icon or button action.

Requested because no page showed an exact reading at all (unlike ZephCore),
and the icon alone gives little information at a glance.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 examples/companion_radio/ui-new/UITask.cpp | 65 +++++++++++++---------
 1 file changed, 40 insertions(+), 25 deletions(-)

diff --git a/examples/companion_radio/ui-new/UITask.cpp b/examples/companion_radio/ui-new/UITask.cpp
index 12955663..69fb2efb 100644
--- a/examples/companion_radio/ui-new/UITask.cpp
+++ b/examples/companion_radio/ui-new/UITask.cpp
@@ -109,6 +109,7 @@ class HomeScreen : public UIScreen {
 #if UI_SENSORS_PAGE == 1
     SENSORS,
 #endif
+    BATTERY,
     SHUTDOWN,
     Count    // keep as last
   };
@@ -122,42 +123,43 @@ class HomeScreen : public UIScreen {
   AdvertPath recent[UI_RECENT_LIST_SIZE];
 
 
-  void renderBatteryIndicator(DisplayDriver& display, uint16_t batteryMilliVolts) {
-    // Convert millivolts to percentage
+  // Shared with the BATTERY home page below, so both use the exact same
+  // clamped estimate (a linear mV->percent approximation, not a lab-accurate
+  // discharge curve -- same one already used for the old icon's fill level,
+  // just surfaced precisely instead of a handful of fill increments).
 #ifndef BATT_MIN_MILLIVOLTS
   #define BATT_MIN_MILLIVOLTS 3000
 #endif
 #ifndef BATT_MAX_MILLIVOLTS
   #define BATT_MAX_MILLIVOLTS 4200
 #endif
-    const int minMilliVolts = BATT_MIN_MILLIVOLTS;
-    const int maxMilliVolts = BATT_MAX_MILLIVOLTS;
-    int batteryPercentage = ((batteryMilliVolts - minMilliVolts) * 100) / (maxMilliVolts - minMilliVolts);
-    if (batteryPercentage < 0) batteryPercentage = 0; // Clamp to 0%
-    if (batteryPercentage > 100) batteryPercentage = 100; // Clamp to 100%
-
-    // battery icon
-    int iconWidth = 24;
-    int iconHeight = 10;
-    int iconX = display.width() - iconWidth - 5; // Position the icon near the top-right corner
-    int iconY = 0;
-    display.setColor(UIColor::title_txt);
-
-    // battery outline
-    display.drawRect(iconX, iconY, iconWidth, iconHeight);
-
-    // battery "cap"
-    display.fillRect(iconX + iconWidth, iconY + (iconHeight / 4), 3, iconHeight / 2);
+  int computeBatteryPercent(uint16_t batteryMilliVolts) {
+    int pct = ((batteryMilliVolts - BATT_MIN_MILLIVOLTS) * 100) / (BATT_MAX_MILLIVOLTS - BATT_MIN_MILLIVOLTS);
+    if (pct < 0) pct = 0;
+    if (pct > 100) pct = 100;
+    return pct;
+  }
 
-    // fill the battery based on the percentage
-    int fillWidth = (batteryPercentage * (iconWidth - 4)) / 100;
-    display.fillRect(iconX + 2, iconY + 2, fillWidth, iconHeight - 4);
+  void renderBatteryIndicator(DisplayDriver& display, uint16_t batteryMilliVolts) {
+    // Percentage text, not an icon: gives an actual number at a glance
+    // instead of a handful of fill increments on a tiny 24x10px icon, and no
+    // other page showed battery level otherwise (unlike ZephCore's dedicated
+    // screen). See the BATTERY home page for the full detail (percentage,
+    // voltage, reference range).
+    char buf[8];
+    sprintf(buf, "%d%%", computeBatteryPercent(batteryMilliVolts));
+    display.setTextSize(1);
+    display.setColor(UIColor::title_txt);
+    int textWidth = display.getTextWidth(buf);
+    int textX = display.width() - textWidth - 2;
+    display.setCursor(textX, 2);
+    display.print(buf);
 
-    // show muted icon if buzzer is muted
+    // show muted icon if buzzer is muted, just to the left of the percentage
 #ifdef PIN_BUZZER
     if (_task->isBuzzerQuiet()) {
       display.setColor(UIColor::warning_txt);
-      display.drawXbm(iconX - 9, iconY + 1, muted_icon, 8, 8);
+      display.drawXbm(textX - 9, 1, muted_icon, 8, 8);
     }
 #endif
   }
@@ -491,6 +493,19 @@ public:
       if (sensors_scroll) sensors_scroll_offset = (sensors_scroll_offset+1)%sensors_nb;
       else sensors_scroll_offset = 0;
 #endif
+    } else if (_page == HomePage::BATTERY) {
+      uint16_t mv = _task->getBattMilliVolts();
+      display.setColor(UIColor::primary_txt);
+      display.setTextSize(1);
+      display.setCursor(0, 20);
+      sprintf(tmp, "Battery: %d%%", computeBatteryPercent(mv));
+      display.print(tmp);
+      display.setCursor(0, 31);
+      sprintf(tmp, "Voltage: %.2f V", mv / 1000.0f);
+      display.print(tmp);
+      display.setCursor(0, 42);
+      sprintf(tmp, "Range: %.2f-%.2f V", BATT_MIN_MILLIVOLTS / 1000.0f, BATT_MAX_MILLIVOLTS / 1000.0f);
+      display.print(tmp);
     } else if (_page == HomePage::SHUTDOWN) {
       display.setColor(UIColor::corp_blue);
       display.setTextSize(1);
-- 
