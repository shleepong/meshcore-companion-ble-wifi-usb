index 69fb2efb..869c845d 100644
--- a/examples/companion_radio/ui-new/UITask.cpp
+++ b/examples/companion_radio/ui-new/UITask.cpp
@@ -309,7 +309,7 @@ public:
       // fit on one 128px-wide line next to a 32x32 icon. Text-status style
       // instead, same layout as the WIFI page.
       display.setTextSize(1);
-      display.setColor(ble_on ? UIColor::corp_blue : UIColor::secondary_txt);
+      display.setColor(ble_on ? UIColor::accent_cyan : UIColor::secondary_txt);
       display.drawTextCentered(display.width() / 2, 24, ble_on ? "BLE: on" : "BLE: off");
       display.setColor(UIColor::secondary_txt);
       display.drawTextCentered(display.width() / 2, 44, "switch (reboot):");
@@ -350,7 +350,7 @@ public:
       // label needs to say "reboot" explicitly, and "switch (reboot): long
       // press" doesn't fit on one 128px-wide line.
       display.setTextSize(1);
-      display.setColor(wifi_on ? UIColor::corp_blue : UIColor::secondary_txt);
+      display.setColor(wifi_on ? UIColor::accent_cyan : UIColor::secondary_txt);
       display.drawTextCentered(display.width() / 2, 20, wifi_on ? "WiFi: on" : "WiFi: off");
       display.setColor(UIColor::primary_txt);
       display.drawTextCentered(display.width() / 2, 34, buf);
