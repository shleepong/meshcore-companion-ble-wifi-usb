+#ifdef DUAL_BLE_WIFI
 // Live radio on/off, no reboot needed -- unlike enable()/disable() on
 // SerialBLEInterface, SerialWifiInterface's own enable()/disable() only
 // gate the TCP server's frame routing, not the WiFi radio itself (see
@@ -1057,6 +1082,52 @@ void UITask::toggleWiFi() {
   }
   _next_refresh = 0;
 }
+#elif defined(EXCLUSIVE_BLE_WIFI)
+// Reboot-based switch: BLE and WiFi are never both initialized in the same
+// boot (see main.cpp's EXCLUSIVE_BLE_WIFI setup() block) -- deliberately no
+// live BLEDevice deinit/reinit here (SerialBLEInterface::disable() only stops
+// advertising/the GATT service, it doesn't free the Bluedroid stack's own
+// memory, see helpers/esp32/SerialBLEInterface.cpp -- a live switch would
+// need that to actually help). Flipping wifi_enabled and restarting into the
+// same already-exercised boot path as the single-purpose BLE-only/WiFi-only
+// envs is simpler and safer, at the cost of a few seconds' reboot when
+// changing mode -- an acceptable trade for a board without PSRAM, where
+// running both radios' init at once was measured to starve WiFi's own
+// association of heap (confirmed on real hardware, 30/08/2026).
+void UITask::toggleWiFi() {
+  const char* msg;
+  if (wifi_active) {
+    // Currently in WiFi mode -- switch back to BLE next boot.
+    _node_prefs->wifi_enabled = 0;
+    msg = "Switching to BLE...";
+  } else {
+    // Currently in BLE mode -- switch to WiFi next boot, if configured.
+    if (_node_prefs->wifi_ssid[0] == 0) {
+      showAlert("Set wifi_ssid first", 1200);
+      return;
+    }
+    _node_prefs->wifi_enabled = 1;
+    msg = "Switching to WiFi...";
+  }
+  the_mesh.savePrefs();
+
+  // showAlert() alone wouldn't make it to the screen -- it just sets state
+  // for the next loop() render pass, which ESP.restart() below would never
+  // reach. Draw directly, same pattern as the low-battery shutdown message
+  // above, so the reboot isn't mistaken for a crash.
+  if (_display != NULL) {
+    _display->startFrame();
+    _display->setTextSize(2);
+    _display->setColor(UIColor::warning_txt);
+    _display->drawTextCentered(_display->width() / 2, 28, msg);
+    _display->setTextSize(1);
+    _display->setColor(UIColor::secondary_txt);
+    _display->drawTextCentered(_display->width() / 2, 48, "rebooting...");
+    _display->endFrame();
+    if (_display->isEink() == false) { delay(1500); }
+  }
+  ESP.restart();
+}
 #endif
 
