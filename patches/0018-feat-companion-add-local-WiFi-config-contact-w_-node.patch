+#endif
   addChannel("Public", PUBLIC_GROUP_PSK); // pre-configure Andy's public channel
   _store->loadChannels(this);
 
@@ -1099,6 +1216,47 @@ void MyMesh::handleCmdFrame(size_t len) {
       text[tlen] = 0; // ensure null
       int result;
       uint32_t expected_ack;
+#if defined(DUAL_BLE_WIFI) || defined(EXCLUSIVE_BLE_WIFI)
+      if (isWifiConfigContact(recipient) && tlen <= MAX_TEXT_LEN) {
+        // Local WiFi-config contact -- never touches the radio. Fabricate the
+        // same SENT-ack hash a real send would produce (composeMsgPacket(),
+        // BaseChatMesh.cpp) from the UNMODIFIED text, before splitting it on
+        // ':' below, so the app can never conclude the message was lost and
+        // retry it.
+        uint8_t temp[5 + MAX_TEXT_LEN + 1];
+        memcpy(temp, &msg_timestamp, 4);
+        temp[4] = (attempt & 3);
+        memcpy(&temp[5], text, tlen + 1);
+        mesh::Utils::sha256((uint8_t *)&expected_ack, 4, temp, 5 + tlen, self_id.pub_key, PUB_KEY_SIZE);
+
+        char reply[48];
+        char *sep = strchr(text, ':');
+        if (sep) {
+          *sep++ = 0;
+          trySetWifiConfigVar(text, sep, reply, sizeof(reply));
+        } else {
+          StrHelper::strzcpy(reply, "ERR use key:value (wifi_ssid/wifi_pwd/wifi_enabled)", sizeof(reply));
+        }
+
+        out_frame[0] = RESP_CODE_SENT;
+        out_frame[1] = 0; // not a flood send
+        memcpy(&out_frame[2], &expected_ack, 4);
+        est_timeout = 500;
+        memcpy(&out_frame[6], &est_timeout, 4);
+        _serial->writeFrame(out_frame, 10);
+
+        // Fabricate the delivery confirmation too: nothing is ever in flight,
+        // so no real ack will ever come back to trigger processAck().
+        out_frame[0] = PUSH_CODE_SEND_CONFIRMED;
+        memcpy(&out_frame[1], &expected_ack, 4);
+        uint32_t trip_time = 0;
+        memcpy(&out_frame[5], &trip_time, 4);
+        _serial->writeFrame(out_frame, 9);
+
+        queueLocalConfigReply(*recipient, getRTCClock()->getCurrentTimeUnique(), reply);
+        return;
+      }
+#endif
       if (txt_type == TXT_TYPE_CLI_DATA) {
         msg_timestamp = getRTCClock()->getCurrentTimeUnique(); // Use node's RTC instead of app timestamp to avoid tripping replay protection
         result = sendCommandData(*recipient, msg_timestamp, attempt, text, est_timeout);
@@ -1851,19 +2009,10 @@ void MyMesh::handleCmdFrame(size_t len) {
       // see main.cpp's DUAL_BLE_WIFI/EXCLUSIVE_BLE_WIFI boot logic for how
       // wifi_enabled is consumed (next boot for both; EXCLUSIVE_BLE_WIFI also
       // needs a reboot to actually switch transport, see UITask::toggleWiFi()).
-      if (strcmp(sp, "wifi_ssid") == 0) {
-        StrHelper::strncpy(_prefs.wifi_ssid, np, sizeof(_prefs.wifi_ssid));
-        savePrefs();
-        writeOKFrame();
-        return;
-      } else if (strcmp(sp, "wifi_pwd") == 0) {
-        StrHelper::strncpy(_prefs.wifi_password, np, sizeof(_prefs.wifi_password));
-        savePrefs();
-        writeOKFrame();
-        return;
-      } else if (strcmp(sp, "wifi_enabled") == 0) {
-        _prefs.wifi_enabled = (np[0] == '1') ? 1 : 0;
-        savePrefs();
+      if (strcmp(sp, "wifi_ssid") == 0 || strcmp(sp, "wifi_pwd") == 0 || strcmp(sp, "wifi_enabled") == 0) {
+        // Shared with the local WiFi-config contact's chat-message path, see
+        // trySetWifiConfigVar() -- same "key:value" syntax either way.
+        trySetWifiConfigVar(sp, np, NULL, 0);
         writeOKFrame();
         return;
       }
