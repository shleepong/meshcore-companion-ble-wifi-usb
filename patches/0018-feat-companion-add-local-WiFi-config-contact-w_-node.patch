+#if defined(DUAL_BLE_WIFI) || defined(EXCLUSIVE_BLE_WIFI)
+void MyMesh::ensureWifiConfigContact() {
+  // Synthetic pubkey derived from our own identity (same principle as
+  // ZephCore's deriveVContactKey(), distinct salt so the two never collide).
+  // No matching private key exists anywhere -- a hand-crafted over-the-air
+  // packet addressed to it is undecryptable and dropped like any other noise,
+  // and it is never used to compute a real shared secret since sendMessage()/
+  // sendCommandData() are never called for it (see the CMD_SEND_TXT_MSG
+  // interception below).
+  static const char SALT[] = "d17-wifi-config-contact";
+  mesh::Utils::sha256(_wifi_contact_key, PUB_KEY_SIZE, (const uint8_t *)SALT, strlen(SALT),
+                       self_id.pub_key, PUB_KEY_SIZE);
+
+  char want_name[32];
+  want_name[0] = 'w';
+  want_name[1] = '_';
+  StrHelper::strzcpy(&want_name[2], _prefs.node_name, sizeof(want_name) - 2);
+
+  ContactInfo *existing = lookupContactByPubKey(_wifi_contact_key, PUB_KEY_SIZE);
+  if (existing) {
+    // Keep the display name in sync with the node name (a persisted contact
+    // doesn't get this for free the way ZephCore's read-time-rebuilt v-contact
+    // does -- a rename would otherwise leave a stale "w_<old name>" forever).
+    if (strcmp(existing->name, want_name) != 0) {
+      StrHelper::strzcpy(existing->name, want_name, sizeof(existing->name));
+      existing->lastmod = getRTCClock()->getCurrentTime();
+      saveContacts();
+    }
+    return; // already present, nothing more to do
+  }
+
+  ContactInfo c;
+  memset(&c, 0, sizeof(c));
+  memcpy(c.id.pub_key, _wifi_contact_key, PUB_KEY_SIZE);
+  c.type = ADV_TYPE_CHAT;
+  c.out_path_len = 0; // "0 hops" -- local, not a real routed contact
+  StrHelper::strzcpy(c.name, want_name, sizeof(c.name));
+  uint32_t now = getRTCClock()->getCurrentTime();
+  c.last_advert_timestamp = now;
+  c.lastmod = now;
+
+  if (addContact(c)) {
+    saveContacts();
+  }
+  // If the table happened to be full, we just retry next boot -- harmless.
+}
+
+bool MyMesh::trySetWifiConfigVar(const char* key, const char* value, char* reply, size_t reply_size) {
+  bool ok = true;
+  if (strcmp(key, "wifi_ssid") == 0) {
+    StrHelper::strncpy(_prefs.wifi_ssid, value, sizeof(_prefs.wifi_ssid));
+    if (reply) {
+      char *dp = reply;
+      strcpy(dp, "OK wifi_ssid=");
+      dp = strchr(dp, 0);
+      StrHelper::strzcpy(dp, _prefs.wifi_ssid, reply_size - (dp - reply));
+    }
+  } else if (strcmp(key, "wifi_pwd") == 0) {
+    StrHelper::strncpy(_prefs.wifi_password, value, sizeof(_prefs.wifi_password));
+    if (reply) StrHelper::strzcpy(reply, "OK wifi_pwd set", reply_size);
+  } else if (strcmp(key, "wifi_enabled") == 0) {
+    _prefs.wifi_enabled = (value[0] == '1') ? 1 : 0;
+    if (reply) {
+      StrHelper::strzcpy(reply, _prefs.wifi_enabled ? "OK wifi_enabled=1 (reboot to apply)"
+                                                     : "OK wifi_enabled=0 (reboot to apply)",
+                          reply_size);
+    }
+  } else {
+    ok = false;
+    if (reply) {
+      char *dp = reply;
+      strcpy(dp, "ERR unknown key: ");
+      dp = strchr(dp, 0);
+      StrHelper::strzcpy(dp, key, reply_size - (dp - reply));
+    }
+  }
+  if (ok) savePrefs();
+  return ok;
+}
+
+void MyMesh::queueLocalConfigReply(const ContactInfo &from, uint32_t sender_timestamp, const char *text) {
+  // Mirrors queueMessage()'s frame layout, but there is no real mesh::Packet
+  // behind this reply (it never travelled over the radio), so SNR is fixed to
+  // 0 and path_len to 0xFF ("direct"), same convention queueMessage() already
+  // uses for a directly-received (non-flooded) message.
+  int i = 0;
+  if (app_target_ver >= 3) {
+    out_frame[i++] = RESP_CODE_CONTACT_MSG_RECV_V3;
+    out_frame[i++] = 0; // SNR
+    out_frame[i++] = 0; // reserved1
+    out_frame[i++] = 0; // reserved2
+  } else {
+    out_frame[i++] = RESP_CODE_CONTACT_MSG_RECV;
+  }
+  memcpy(&out_frame[i], from.id.pub_key, 6);
+  i += 6;
+  out_frame[i++] = 0xFF; // path_len: direct
+  out_frame[i++] = TXT_TYPE_PLAIN;
+  memcpy(&out_frame[i], &sender_timestamp, 4);
+  i += 4;
+  int tlen = strlen(text);
+  if (i + tlen > MAX_FRAME_SIZE) tlen = MAX_FRAME_SIZE - i;
+  memcpy(&out_frame[i], text, tlen);
+  i += tlen;
+  addToOfflineQueue(out_frame, i);
+
+  if (_serial->isConnected()) {
+    uint8_t frame[1];
+    frame[0] = PUSH_CODE_MSG_WAITING; // send push 'tickle'
+    _serial->writeFrame(frame, 1);
+  }
+}
+#endif
+
 bool MyMesh::filterRecvFloodPacket(mesh::Packet* packet) {
   // REVISIT: try to determine which Region (from transport_codes[1]) that Sender is indicating for replies/responses
   //    if unknown, fallback to finding Region from transport_codes[0], the 'scope' used by Sender
@@ -970,6 +1084,9 @@ void MyMesh::begin(bool has_display) {
   resetContacts();
   _store->loadContacts(this);
   bootstrapRTCfromContacts();
