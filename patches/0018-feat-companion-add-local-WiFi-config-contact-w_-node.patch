+#if defined(DUAL_BLE_WIFI) || defined(EXCLUSIVE_BLE_WIFI)
+  // Local WiFi-config contact ("w_<node name>"): lets a companion app set
+  // wifi_ssid/wifi_pwd/wifi_enabled via an ordinary chat message, entirely over
+  // the already-connected BLE/USB/WiFi link -- no LoRa packet is ever built or
