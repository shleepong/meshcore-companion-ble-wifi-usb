From ae00673350d18347fefbe9e3d610e609928b6de5 Mon Sep 17 00:00:00 2001
From: GNB Build <palimpseste@quidam.eu>
Date: Sun, 30 Aug 2026 08:26:04 +0200
Subject: [PATCH 08/17] ui: dark theme for ST7735 boards (Tracker V2/V1, T096)
 - black background

Only window_bkg (white->black) and primary_txt (black->white) change.
Everything else (title bar blue, warning orange, popup cyan+black) stays
as-is: it already reads fine on black, and a real hardware INVON would
have flipped those too, into unrelated hues (blue->yellow, orange->
cyan-ish, cyan->red-ish) -- not what was wanted here.

Not yet tested on real hardware.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 src/helpers/ui/ST7735Display.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/helpers/ui/ST7735Display.cpp b/src/helpers/ui/ST7735Display.cpp
index 344f5b1d..7e0c5d73 100644
--- a/src/helpers/ui/ST7735Display.cpp
+++ b/src/helpers/ui/ST7735Display.cpp
@@ -418,10 +418,16 @@ bool ST7735Display::i2c_probe(TwoWire& wire, uint8_t addr) {
 #endif
 
 // Color scheme
-ColorVal UIColor::window_bkg = ST77XX_WHITE;
+// Dark theme (GNB): only the main window background/text are flipped from the
+// stock light theme. Everything else (title bar blue, warning orange, popup
+// cyan+black) already reads fine on a black background, so it stays
+// untouched rather than being bit-inverted wholesale -- a real INVON would
+// also flip title_bkg/warning_txt/popup_bkg into unrelated hues (blue->
+// yellow, orange->cyan-ish, cyan->red-ish), which is not what's wanted here.
+ColorVal UIColor::window_bkg = ST77XX_BLACK;
 ColorVal UIColor::title_bkg = ST77XX_BLUE;
 ColorVal UIColor::title_txt = ST77XX_WHITE;
-ColorVal UIColor::primary_txt = ST77XX_BLACK;
+ColorVal UIColor::primary_txt = ST77XX_WHITE;
 ColorVal UIColor::secondary_txt = (18 << 11) | (36 << 5) | 18;  // mid-gray
 ColorVal UIColor::warning_txt = ST77XX_ORANGE;
 ColorVal UIColor::popup_bkg = ST77XX_CYAN;
-- 
